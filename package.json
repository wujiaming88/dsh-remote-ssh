{
  "name": "@wujiaming88/dsh-remote-ssh",
  "version": "3.0.0-rc.4",
  "description": "Remote-only Claude Code and Codex sessions over SSH, with Host-owned workspaces, durable lifecycle, human input and session-scoped files.",
  "keywords": [
    "dsh",
    "ssh",
    "kerberos",
    "gssapi",
    "codex",
    "claude-code",
    "acp"
  ],
  "author": {
    "name": "wujiaming88",
    "url": "https://github.com/wujiaming88"
  },
  "homepage": "https://github.com/wujiaming88/dsh-remote-ssh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wujiaming88/dsh-remote-ssh.git"
  },
  "bugs": {
    "url": "https://github.com/wujiaming88/dsh-remote-ssh/issues"
  },
  "type": "module",
  "scripts": {
    "build:client": "node build-client.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.9.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2"
  }
}
